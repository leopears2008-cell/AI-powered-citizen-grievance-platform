# Server-only secrets
GEMINI_API_KEY=

# Firebase Admin SDK service account JSON. Never expose this to Vite/client code.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: Admin SDK Firestore database ID. Defaults to firestoreDatabaseId in firebase-applet-config.json.
FIRESTORE_DATABASE_ID=

# Comma-separated allowlist for server-side admin API authorization.
ADMIN_EMAILS=

# Client-safe Firebase configuration is already in firebase-applet-config.json.
# Optional Vite overrides for the public web app configuration. These values are
# shipped to the browser and are not secrets. Firebase Authentication still
# enforces access; never put service-account credentials or private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=
