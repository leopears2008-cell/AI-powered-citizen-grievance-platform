# Server-only secrets
GEMINI_API_KEY=

# Firebase Admin SDK service account JSON. Never expose this to Vite/client code.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: Admin SDK Firestore database ID. Defaults to firestoreDatabaseId in firebase-applet-config.json.
FIRESTORE_DATABASE_ID=

# Comma-separated allowlist for server-side admin API authorization.
ADMIN_EMAILS=

# Client-safe Firebase configuration is already in firebase-applet-config.json.
